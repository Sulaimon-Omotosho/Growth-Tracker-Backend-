generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  password        String?
  username        String?       @unique
  firstName       String?
  lastName        String?
  phone           String?
  gender          Gender?
  role            Role          @default(MEMBER)
  image           String?
  about           String?
  dob             DateTime?
  provider        String?
  providerId      String?
  addressId       String?
  districtId      String?
  communityId     String?
  zoneId          String?
  cellId          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        Account[]
  leadsCell       Cell[]        @relation("CellLeader")
  leadsChurchTeam ChurchTeam[]  @relation("TeamPastor")
  leadsCommunity  Community[]   @relation("CommunityLeader")
  hod             Department[]  @relation("HOD")
  leadsSubTeam    DepTeam[]     @relation("SubTeamLeader")
  leadsSmallGroup SmallGroup[]     @relation("SmallGroupLeader")
  districtsLed    District[]    @relation("DistrictLeader")
  growthRecord    GrowthRecord?
  reports         Report[]      @relation("UserReports")
  sessions        Session[]
  address         Address?      @relation(fields: [addressId], references: [id])
  cell            Cell?         @relation(fields: [cellId], references: [id])
  community       Community?    @relation(fields: [communityId], references: [id])
  district        District?     @relation("DistrictUsers", fields: [districtId], references: [id])
  zone            Zone?         @relation(fields: [zoneId], references: [id])
  leadsZone       Zone[]        @relation("ZonalLeader")
  departments     Department[]  @relation("UserDepartments")
  teams           ChurchTeam[]  @relation("UserTeams")
  smallGroups     SmallGroup[]  @relation("UserSmallGroups")
  subTeam         DepTeam[]     @relation("UserDepTeams")
  eventVolunteer  Event[]       @relation("EventVolunteers")

  // Messages
  conversations    ConversationParticipant[]
  sentMessages     Message[]                 @relation("SentMessages")

  notificationsReceived  Notification[]      @relation("NotificationRecipient")
  notificationsTriggered Notification[]      @relation("NotificationSender")

  authoredAnnouncements  Announcement[]      @relation("AuthorAnnouncements")
}

model Address {
  id      String  @id @default(uuid())
  street  String?
  city    String
  state   String
  country String
  zipCode String?
  cells   Cell[]
  users   User[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model District {
  id          String      @id @default(uuid())
  name        String
  leaderId    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  communities Community[]
  leader      User?       @relation("DistrictLeader", fields: [leaderId], references: [id])
  users       User[]      @relation("DistrictUsers")
}

model Community {
  id         String   @id @default(uuid())
  name       String
  districtId String
  leaderId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  cells      Cell[]
  district   District @relation(fields: [districtId], references: [id])
  leader     User?    @relation("CommunityLeader", fields: [leaderId], references: [id])
  users      User[]
  zones      Zone[]

  @@unique([name, districtId])
}

model Zone {
  id          String    @id @default(uuid())
  name        String
  communityId String
  leaderId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cells       Cell[]
  users       User[]
  community   Community @relation(fields: [communityId], references: [id])
  leader      User?     @relation("ZonalLeader", fields: [leaderId], references: [id])
}

model Cell {
  id          String    @id @default(uuid())
  name        String
  zoneId      String
  communityId String
  leaderId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  addressId   String?
  isOnline    Boolean   @default(false)
  address     Address?  @relation(fields: [addressId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])
  leader      User?     @relation("CellLeader", fields: [leaderId], references: [id])
  zone        Zone      @relation(fields: [zoneId], references: [id])
  users       User[]
}

model ChurchTeam {
  id          String       @id @default(uuid())
  name        String
  description String?
  leaderId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  leader      User?        @relation("TeamPastor", fields: [leaderId], references: [id])
  departments Department[]
  members     User[]       @relation("UserTeams")
}

model Department {
  id           String     @id @default(uuid())
  name         String
  churchTeamId String
  email        String?
  description  String?
  leaderId     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  leader       User?      @relation("HOD", fields: [leaderId], references: [id])
  depTeams     DepTeam[]
  churchTeam   ChurchTeam @relation(fields: [churchTeamId], references: [id])
  members      User[]     @relation("UserDepartments")
}

model DepTeam {
  id           String   @id @default(uuid())
  name         String
  departmentId String
  leaderId     String?
  leader       User?    @relation("SubTeamLeader", fields: [leaderId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])
  members      User[]   @relation("UserDepTeams")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SmallGroup {
  id           String   @id @default(uuid())
  name         String
  interests    Interest[] @relation("GroupToInterest")
  description  String?
  leaderId     String?
  leader       User?    @relation("SmallGroupLeader", fields: [leaderId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      User[]   @relation("UserSmallGroups")
}

model Interest {
  id      String       @id @default(uuid())
  name    String       @unique
  groups  SmallGroup[] @relation("GroupToInterest")
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  location    String?
  type        EventType @default(GENERAL) 
  status      Status    @default(SCHEDULED)

  sessions    EventSession[]
  capacity      Int?      
  remindersSent Boolean   @default(false)
  volunteers    User[]      @relation("EventVolunteers")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EventSession {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  start     DateTime
  end       DateTime

  createdAt DateTime @default(now())
}

enum EventType {
  GENERAL
  SERVICE
  OUTREACH
  MEETING
  SMALL_GROUP
}

enum Status {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  imageUrl    String?
  
  scope       AnnouncementScope @default(GENERAL)
  targetId    String?           
  
  priority    Priority          @default(NORMAL)

  authorId    String
  author      User              @relation("AuthorAnnouncements", fields: [authorId], references: [id])

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([scope, targetId]) 
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  message     String?
  
  senderId    String?
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id])
  
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id])

  type        NotificationType @default(GENERAL)
  link        String?          
  
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
}

model Conversation {
  id           String                    @id @default(uuid())
  lastMessage  String?                   @db.Text
  updatedAt    DateTime                  @updatedAt
  createdAt    DateTime                  @default(now())
  
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  
  lastClearedAt  DateTime     @default(now())
  
  user           User         @relation(fields: [userId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
}

model Message {
  id             String       @id @default(uuid())
  content        String       @db.Text
  
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)

  @@index([conversationId, createdAt])
}

enum AnnouncementScope {
  GENERAL
  DISTRICT
  COMMUNITY
  ZONE
  CELL
  SMALL_GROUP
  TEAM
  DEPARTMENT
}

enum NotificationType {
  GENERAL
  ANNOUNCEMENT
  EVENT
  MESSAGE
  TASK
  REQUEST
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model GrowthRecord {
  id               String       @id @default(uuid())
  userId           String       @unique
  baptism          Boolean      @default(false)
  foundationCourse CourseStatus @default(NOT_STARTED)
  maturityCourse   CourseStatus @default(NOT_STARTED)
  joinedDepartment Boolean      @default(false)
  joinedCell       Boolean      @default(false)
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id])
}

model Report {
  id         String     @id @default(uuid())
  title      String
  type       ReportType
  content    String
  authorId   String
  zoneId     String?
  districtId String?
  cellId     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  author     User       @relation("UserReports", fields: [authorId], references: [id])
}

enum Role {
  CAMPUS_PASTOR
  PASTOR
  TEAM
  HOD
  DISTRICT
  COMMUNITY
  ZONE
  CELL
  MEMBER
}

enum Gender {
  MALE
  FEMALE
}

enum ReportType {
  WEEKLY
  MONTHLY
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
